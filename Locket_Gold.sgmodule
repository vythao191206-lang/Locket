#!name=Locket_Gold
#!desc=Crack Full

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/giahanhalong-droid/locketgold/refs/heads/main/Locket_DuyVinh09.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/duyvinh09/Module_IOS/refs/heads/main/js/deleteHeader.js, timeout=60

locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://github.com/giahanhalong-droid/locketgold/raw/refs/heads/main/Locket_Unlocked.js, requires-body=true, max-size=-1, timeout=60
[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com